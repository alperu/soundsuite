; @lancedb/lancedb peer-caps apache-arrow at <=18.1.0 while the project uses ^21,
; a known upstream peer-range lag. Install with legacy peer resolution so
; `npm ci` in CI and the Docker build match how the lockfile + local node_modules
; were produced (otherwise npm ci fails with ERESOLVE). Remove once lancedb widens
; its apache-arrow peer range.
legacy-peer-deps=true
