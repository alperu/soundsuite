# Database
DATABASE_URL="file:./data/sound-suite.db"

# Embedding Provider Configuration
# Options: "transformers" | "openai" | "claude" | "ollama"
EMBEDDING_PROVIDER="transformers"
EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"

# API Keys (required for OpenAI or Claude providers)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# MCP Server Configuration
MCP_PORT=3001
MCP_AUTH_MODE="none"
# MCP_AUTH_MODE options: "oauth" | "apikey" | "none"
MCP_API_KEYS=""

# Job Queue Configuration
JOB_CONCURRENCY=2
JOB_MAX_RETRIES=3

# Redis Configuration (for folder caching, SSE, worker pool)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker Pool PID Controller
WORKER_POOL_SIZE=20
MIN_UI_WORKERS=3
MIN_BG_WORKERS=2
PID_KP=2.0
PID_KI=0.5
PID_KD=0.1

# Public PID vars (for admin UI defaults)
NEXT_PUBLIC_PID_KP=2.0
NEXT_PUBLIC_PID_KI=0.5
NEXT_PUBLIC_PID_KD=0.1
NEXT_PUBLIC_WORKER_POOL_SIZE=20
NEXT_PUBLIC_MIN_UI_WORKERS=3
NEXT_PUBLIC_MIN_BG_WORKERS=2
