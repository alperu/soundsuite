# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/migrations
/prisma/data/

# data (databases, vectors, backups)
/data

# exhibits
/public/exhibits

# sidecar
/sideCar/.next/
/sideCar/node_modules/
/public/sideCar/builds

# IDE
.idea/
.vscode/
.kiro/

# runtime
/.pids/
/logs/
eng.traineddata

# backups
/backups/

# personal / dev artifacts
/marketing/
/screenshots/
chat.txt
tmp-*.js
tmp-*.mjs
.mcp.json

# Claude Code (user-specific)
.claude/

# Local project embedding/runtime cache
.cache/

# Sidecar runtime config — holds the AES-256-GCM encrypted OpenRouter store
# (openrouter.enc.json). Encrypted at rest, but a usable credential must never
# reach git regardless.
sideCar/config/

# Credential backups. .env and .mcp.json are ignored, but their .bak siblings
# were not — and those hold the same secrets. A `git add -A` would have pushed
# a live MCP bearer token to a public remote.
.env.bak*
.env.*.bak
.mcp.json.bak
.mcp.json.*.bak
