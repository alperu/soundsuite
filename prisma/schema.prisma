// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7+: `url` no longer lives here. The runtime URL is supplied by the
  // driver adapter in src/lib/db/prisma.ts; the migrate runner reads it from
  // prisma.config.ts at the project root.
  provider = "sqlite"
}

model Case {
  id                String             @id @default(uuid())
  name              String
  path              String             @unique
  caseNumber        String?
  jurisdiction      String?
  country           String?            @default("United States")
  state             String?
  county            String?
  // XETO v1 — site-level tag bag (Haystack `site` markers + ref lists)
  tags              Json               @default("{}")
  jurisdictionId    String?
  jurisdictionRel   Jurisdiction?      @relation(fields: [jurisdictionId], references: [id])
  courtId           String?
  court             Court?             @relation(fields: [courtId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  documents         Document[]
  filings           Filing[]
  drafts            Draft[]
  draftCases        DraftCase[]
  motions           Motion[]           @relation("Case_motions")
  motionEvents      MotionEvent[]
  motionAttachments MotionAttachment[]
  hearings          HearingCase[]
  clerksRecords     ClerksRecord[]
  reportersRecords  ReportersRecord[]

  @@index([path])
  @@index([caseNumber])
  @@index([jurisdictionId])
  @@index([courtId])
}

model Filing {
  id                String     @id @default(uuid())
  caseId            String
  case              Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filingType        String
  title             String
  slug              String
  filingDate        DateTime?
  description       String?
  volumeNumber      Int?
  isSupplemental    Boolean    @default(false)
  supplementalOrder Int? // 1 = 1st supplemental, 2 = 2nd, etc.
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  documents         Document[]
  motions           Motion[]

  @@unique([caseId, slug])
  @@index([caseId])
  @@index([filingType])
}

model Document {
  id               String   @id @default(uuid())
  caseId           String
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filingId         String?
  filing           Filing?  @relation(fields: [filingId], references: [id], onDelete: SetNull)
  filePath         String   @unique
  fileName         String
  hash             String   @unique
  status           String   @default("QUEUED")
  documentType     String?
  documentSummary  String?
  exhibitLabel     String?
  errorMessage     String?
  pageCount        Int?
  detectedExhibits Int      @default(0)
  embeddingModel   String?
  ingestCheckpoint String?
  // AI Readiness Score — 0-100 ingestion quality gate, scored at the end of
  // ingestion before PageCache cleanup. Null = not yet scored.
  readinessScore    Int?
  readinessBand     String?   // 'HIGH' | 'OK' | 'RISKY' | 'POOR'
  readinessWarnings Json?     // ReadinessWarning[] (src/lib/ingestion/readiness/types.ts)
  readinessScoredAt DateTime?
  // XETO v1 — generic tag bag
  tags             Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  motionEvents       MotionEvent[]      @relation("Document_motionEvents")
  motionAttachments  MotionAttachment[] @relation("Document_motionAttachments")
  hearingTranscripts Hearing[]          @relation("Document_hearingTranscripts")
  clerksRecords      ClerksRecord[]     @relation("Document_clerksRecords")
  reportersRecords   ReportersRecord[]  @relation("Document_reportersRecords")

  @@index([caseId])
  @@index([filingId])
  @@index([status])
  @@index([hash])
  @@index([documentType])
  @@index([embeddingModel])
  @@index([readinessBand])
}

model JobLog {
  id                 String    @id @default(uuid())
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  documentsQueued    Int
  documentsProcessed Int
  documentsFailed    Int
  errorSummary       String?

  @@index([startedAt])
}

model Config {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ChatAttachment {
  id          String   @id @default(uuid())
  chatId      String
  fileName    String
  hash        String
  sizeBytes   Int
  mimeType    String   @default("application/pdf")
  kind        String   @default("pdf")
  pageCount   Int?
  chunkCount  Int?
  imageWidth  Int?
  imageHeight Int?
  status      String   @default("QUEUED")
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([chatId, hash])
  @@index([chatId])
}

model ModelDownload {
  id               String    @id @default(uuid())
  modelName        String    @unique
  provider         String
  status           String
  downloadProgress Float     @default(0)
  sizeBytes        BigInt?
  downloadedAt     DateTime?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([provider])
  @@index([status])
}

model PageCache {
  id          String   @id @default(uuid())
  documentId  String
  pageNumber  Int
  text        String
  textDensity Int
  source      String // 'extract' or 'ocr'
  confidence  Float?
  createdAt   DateTime @default(now())

  @@unique([documentId, pageNumber])
  @@index([documentId])
  @@index([source])
}

model ActionLog {
  id        String   @id @default(uuid())
  caseId    String?
  action    String
  target    String
  status    String   @default("pending")
  detail    String?
  logType   String   @default("general")
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([logType])
  @@index([createdAt])
  @@index([status])
}

model Motion {
  id          String    @id @default(uuid())
  filingId    String
  filing      Filing    @relation(fields: [filingId], references: [id], onDelete: Cascade)
  title       String
  startPage   Int
  endPage     Int?
  description String?
  exhibits    Exhibit[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // XETO v1 — equip-level container
  tags   Json    @default("{}")
  // Case denorm — every Motion belongs to a Case (matches XETO caseRef).
  // Nullable for backfill safety; tighten after backfill completes.
  caseId String?
  case   Case?   @relation("Case_motions", fields: [caseId], references: [id], onDelete: Cascade)

  // Sub-motion / nesting (Haystack equipRef analog).
  parentMotionId String?
  parentMotion   Motion?  @relation("MotionAmendment", fields: [parentMotionId], references: [id])
  childMotions   Motion[] @relation("MotionAmendment")

  // Amendable mixin: amends/supersedes are semantic pointers; kept as plain
  // String? columns rather than FKs (the only structural FK is parentMotionId).
  amendsId     String?
  supersedesId String?
  revisionSeq  Int?

  // Denormalised Person refs — single-actor fast path.
  judgeId      String?
  judge        Person? @relation("Motion_judge", fields: [judgeId], references: [id])
  movantId     String?
  movant       Person? @relation("Motion_movant", fields: [movantId], references: [id])
  respondentId String?
  respondent   Person? @relation("Motion_respondent", fields: [respondentId], references: [id])

  events      MotionEvent[]
  attachments MotionAttachment[]
  hearings    HearingMotion[]

  @@index([filingId])
  @@index([caseId])
  @@index([parentMotionId])
  @@index([amendsId])
  @@index([judgeId])
  @@index([movantId])
}

model Exhibit {
  id          String   @id @default(uuid())
  motionId    String
  motion      Motion   @relation(fields: [motionId], references: [id], onDelete: Cascade)
  label       String
  title       String?
  startPage   Int
  endPage     Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([motionId])
}

model WorkflowTemplate {
  id           String     @id @default(uuid())
  name         String     @unique
  jurisdiction String?
  category     String?
  tags         String     @default("[]")
  description  String?
  content      String
  workflows    Workflow[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([category])
}

model Workflow {
  id         String            @id @default(uuid())
  caseId     String
  templateId String?
  template   WorkflowTemplate? @relation(fields: [templateId], references: [id])
  title      String
  slug       String
  content    String            @default("")
  status     String            @default("draft")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([caseId, slug])
  @@index([caseId])
}

model Draft {
  id             String            @id @default(uuid())
  caseId         String
  case           Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  documentType   String
  content        String            @default("")
  status         String            @default("draft")
  version        Int               @default(1)
  // Vector indexing tracking
  indexingStatus String?
  lastIndexedAt  DateTime?
  indexedVersion Int?
  embeddingModel String?
  indexingError  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  versions       DraftVersion[]
  draftCases     DraftCase[]
  suggestions    DraftSuggestion[]

  @@unique([caseId, slug])
  @@index([caseId])
  @@index([documentType])
}

model DraftCase {
  id        String   @id @default(uuid())
  draftId   String
  draft     Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([draftId, caseId])
  @@index([draftId])
  @@index([caseId])
}

model DraftVersion {
  id            String   @id @default(uuid())
  draftId       String
  draft         Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  version       Int
  content       String
  changeSummary String?
  createdAt     DateTime @default(now())

  @@index([draftId])
}

// Auto-suggest mode: structured edit proposals generated by the AI in the draft chat
// panel. Each row is one suggestion card; status transitions accepted/denied/ignored
// drive the learning loop via UserPreferenceSignal.
model DraftSuggestion {
  id                String    @id @default(uuid())
  draftId           String
  draft             Draft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  sessionId         String // groups suggestions from one chat turn
  draftVersion      Int // Draft.version at creation time
  anchorFrom        Int // PM pos at creation (seed for live mapping)
  anchorTo          Int
  originalText      String // exact substring the AI targeted
  proposedText      String // replacement
  category          String // tone|grammar|structure|citation|clarity|other
  reason            String // AI rationale (<= 240 chars)
  confidence        Float? // optional 0-1 from model
  status            String    @default("pending") // pending|accepted|denied|ignored|stale
  denyReasonTags    String    @default("[]") // JSON array of tag slugs
  denyReasonText    String? // optional free text
  regenerationCount Int       @default(0) // times the Regenerate button was used on this row (max 3)
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([draftId, status])
  @@index([sessionId])
}

// Learning loop: one row per learned user preference, derived from accepted/denied
// DraftSuggestion rows. Summarised and injected into the system prompt on subsequent
// Auto-Suggest calls so the AI adapts to the user's style.
model UserPreferenceSignal {
  id           String   @id @default(uuid())
  caseId       String? // nullable scoping tiers
  draftId      String?
  documentType String? // e.g. "motion", "brief"
  signal       String // prefer|avoid
  category     String // mirrors DraftSuggestion.category
  summary      String // <= 120 char rule
  examplePairs String   @default("[]") // JSON: up to 3 {original, proposed} few-shot pairs
  weight       Float    @default(1.0) // decays over time
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([draftId, signal, category])
  @@index([caseId])
}

model SidecarCommand {
  id         String   @id @default(uuid())
  sidecarUrl String
  action     String
  payload    String   @default("{}")
  status     String   @default("pending")
  result     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime

  @@index([sidecarUrl, status])
  @@index([status, expiresAt])
}

// ─── Role Registry (simplified — fixed mode catalog) ────────────────────
//
// The RoleType CRUD model was retired in favor of a fixed 4-mode catalog
// resolved per-OS by the sidecar (see sideCar/src/lib/mode-templates.ts).
// Operators no longer pick image/port/vram/type — they just enable modes
// per sidecar and optionally override the model. HostRoleAssignment now
// keys by `mode` string instead of a RoleType FK.

model HostProvisioning {
  id                  String   @id @default(cuid())
  sidecarUrl          String   @unique
  hostOsOverride      String?
  masterUrlForHost    String?
  // Optional override of the master's WebSocket relay port for this host.
  // Sidecars connect to <masterHost>:<masterWsPortForHost>/sidecar — default
  // is 3002 (GPU_WS_PORT on the master). Override per host when this master
  // accepts WS upgrades on a different port (e.g. Fantom MCP at 3848).
  masterWsPortForHost Int?
  notes               String?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@index([sidecarUrl])
}

model HostRoleAssignment {
  id             String   @id @default(cuid())
  sidecarUrl     String // e.g. "http://10.10.20.5:8098"
  mode           String // 'ss-embedding' | 'ss-completion' | 'ss-ocr' | 'ss-reranker'
  enabled        Boolean  @default(true)
  minOnline      Int      @default(0)
  idleTimeoutMin Int      @default(5)
  modelOverride  String?
  // Where the operator wants this role to run on the sidecar:
  //   'host'         — native Ollama on the sidecar host (host.docker.internal)
  //   'docker-ollama' — sidecar runs `ollama/ollama` as a container w/ GPU passthrough
  //   'docker-vllm'  — sidecar runs `vllm/vllm-openai` as a container (CUDA only)
  // Defaults to 'docker-ollama' on linux/win32 and 'host' on darwin (handled
  // in app code; column default is the most-common cross-platform value).
  runtime        String?  @default("docker-ollama")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sidecarUrl, mode])
  @@index([sidecarUrl])
}

// ─── XETO v1 foundation ─────────────────────────────────────────────────
//
// New entities for the XETO/Haystack work documented in
// `docs/xeto-haystack-research.md`. Tag bags live in `tags Json` columns;
// hot tags are exposed via VIRTUAL generated columns added in the
// hand-edited migration SQL (see §12.2 of the research doc).

model Jurisdiction {
  id        String   @id @default(cuid())
  code      String   @unique // "TX" | "CA" | "US-FED" | ...
  name      String
  tags      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases   Case[]
  persons Person[]
  courts  Court[]
}

model Court {
  id             String        @id @default(cuid())
  name           String
  shortName      String?
  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])
  courtType      String? // "trial" | "appellate" | "supreme" | "magistrate"
  address        String?
  phone          String?
  website        String?
  tags           Json          @default("{}")
  cases          Case[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([jurisdictionId])
  @@index([name])
  @@index([courtType])
}

model Person {
  id             String        @id @default(cuid())
  displayName    String
  email          String?
  barNumber      String?
  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])
  // Intrinsic markers — { person, lawyer?, judge?, courtClerk?, courtReporter?,
  // bailiff?, proSe?, self? }
  tags           Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  roles               PersonRole[]
  motionsAsJudge      Motion[]           @relation("Motion_judge")
  motionsAsMovant     Motion[]           @relation("Motion_movant")
  motionsAsRespondent Motion[]           @relation("Motion_respondent")
  eventsAuthored      MotionEvent[]      @relation("MotionEvent_authoredBy")
  eventsServedOn      MotionEvent[]      @relation("MotionEvent_servedOn")
  eventsAsClerk       MotionEvent[]      @relation("MotionEvent_courtClerk")
  eventsAsReporter    MotionEvent[]      @relation("MotionEvent_courtReporter")
  attachmentsAuthored MotionAttachment[] @relation("MotionAttachment_authoredBy")
  hearingsAsJudge     Hearing[]          @relation("Hearing_judge")
  hearingsAsClerk     Hearing[]          @relation("Hearing_courtClerk")
  hearingsAsReporter  Hearing[]          @relation("Hearing_courtReporter")
  reportersRecords    ReportersRecord[]  @relation("ReportersRecord_reporter")

  @@index([displayName])
  @@index([jurisdictionId])
}

model PersonRole {
  id         String    @id @default(cuid())
  personId   String
  person     Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  scopeKind  String // "motion" | "case"
  scopeId    String // Motion.id or Case.id (polymorphic)
  // Contextual markers — { personRole, movant?, respondent?, defendant?, ... }
  tags       Json      @default("{}")
  appearedOn DateTime?
  withdrewOn DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([personId])
  @@index([scopeKind, scopeId])
}

model MotionEvent {
  id              String    @id @default(cuid())
  motionId        String
  motion          Motion    @relation(fields: [motionId], references: [id], onDelete: Cascade)
  caseId          String
  case            Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  // EventKind: received | filed | courtFiled | responded | signed | granted |
  //            denied | served | hearingHeld | withdrawn | mooted
  kind            String
  occurredOn      DateTime
  courtFilingDate DateTime?
  causeNoStamp    String?

  documentId      String?
  document        Document? @relation("Document_motionEvents", fields: [documentId], references: [id], onDelete: SetNull)
  authoredById    String?
  authoredBy      Person?   @relation("MotionEvent_authoredBy", fields: [authoredById], references: [id])
  servedOnId      String?
  servedOn        Person?   @relation("MotionEvent_servedOn", fields: [servedOnId], references: [id])
  courtClerkId    String?
  courtClerk      Person?   @relation("MotionEvent_courtClerk", fields: [courtClerkId], references: [id])
  courtReporterId String?
  courtReporter   Person?   @relation("MotionEvent_courtReporter", fields: [courtReporterId], references: [id])
  hearingId       String?
  hearing         Hearing?  @relation(fields: [hearingId], references: [id], onDelete: SetNull)

  tags      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([motionId, kind])
  @@index([occurredOn])
  @@index([kind, courtFilingDate])
  @@index([authoredById])
  @@index([caseId])
  @@index([documentId])
  @@index([hearingId])
}

model MotionAttachment {
  id             String    @id @default(cuid())
  motionId       String
  motion         Motion    @relation(fields: [motionId], references: [id], onDelete: Cascade)
  caseId         String
  case           Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  // attachmentKind: proposedOrder | brief | response | email | evidence |
  //                 exhibit | supportingDoc | order | transcript | affidavit |
  //                 subpoena | judgment | settlement | notice | rfa |
  //                 billOfReview | petition
  attachmentKind String
  documentId     String?
  document       Document? @relation("Document_motionAttachments", fields: [documentId], references: [id], onDelete: SetNull)

  // Amendable mixin: self-FKs for amends/supersedes chains within attachments.
  amendsId     String?
  amends       MotionAttachment?  @relation("Attachment_amends", fields: [amendsId], references: [id])
  amendedBy    MotionAttachment[] @relation("Attachment_amends")
  supersedesId String?
  supersedes   MotionAttachment?  @relation("Attachment_supersedes", fields: [supersedesId], references: [id])
  supersededBy MotionAttachment[] @relation("Attachment_supersedes")
  revisionSeq  Int?

  authoredById String?
  authoredBy   Person? @relation("MotionAttachment_authoredBy", fields: [authoredById], references: [id])

  tags      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([motionId, attachmentKind])
  @@index([amendsId])
  @@index([caseId])
  @@index([documentId])
}

// Hearing — shared entity. Hybrid hearings span many cases & many motions
// via join tables. Per-motion timeline link lives on MotionEvent.hearingId.
model Hearing {
  id                   String    @id @default(cuid())
  judgeId              String?
  judge                Person?   @relation("Hearing_judge", fields: [judgeId], references: [id])
  courtReporterId      String?
  courtReporter        Person?   @relation("Hearing_courtReporter", fields: [courtReporterId], references: [id])
  courtClerkId         String?
  courtClerk           Person?   @relation("Hearing_courtClerk", fields: [courtClerkId], references: [id])
  scheduledFor         DateTime
  heldOn               DateTime?
  durationMin          Int?
  location             String?
  transcriptDocumentId String?
  transcriptDocument   Document? @relation("Document_hearingTranscripts", fields: [transcriptDocumentId], references: [id], onDelete: SetNull)
  hearingType          String?
  tags                 Json      @default("{}")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  cases   HearingCase[]
  motions HearingMotion[]
  events  MotionEvent[]

  @@index([scheduledFor])
  @@index([judgeId])
}

model HearingCase {
  hearingId String
  hearing   Hearing @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  caseId    String
  case      Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@id([hearingId, caseId])
  @@index([caseId])
}

model HearingMotion {
  hearingId String
  hearing   Hearing @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  motionId  String
  motion    Motion  @relation(fields: [motionId], references: [id], onDelete: Cascade)

  @@id([hearingId, motionId])
  @@index([motionId])
}

// ─── Case-level record entities (appellate) ─────────────────────────────
//
// Some filing types are case-level, not motion-attached: the Clerk's Record
// (appellate clerk's compilation of trial-court papers) and the Reporter's
// Record (court reporter's transcript of trial proceedings, often in volumes).
// Modeled as first-class entities so the tag panel can edit them directly,
// rather than forcing them into MotionAttachment (which requires a motionId).

model ClerksRecord {
  id         String    @id @default(cuid())
  caseId     String
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  volume     Int?
  filedOn    DateTime?
  documentId String?
  document   Document? @relation("Document_clerksRecords", fields: [documentId], references: [id], onDelete: SetNull)
  // XETO v1 — tag bag (markers/refs/values)
  tags       Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([caseId])
  @@index([documentId])
}

model ReportersRecord {
  id          String    @id @default(cuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reporterId  String?
  reporter    Person?   @relation("ReportersRecord_reporter", fields: [reporterId], references: [id])
  volume      Int?
  hearingDate DateTime?
  documentId  String?
  document    Document? @relation("Document_reportersRecords", fields: [documentId], references: [id], onDelete: SetNull)
  tags        Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([caseId])
  @@index([reporterId])
  @@index([documentId])
}
