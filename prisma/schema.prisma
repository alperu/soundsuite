// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Case {
  id           String      @id @default(uuid())
  name         String
  path         String      @unique
  caseNumber   String?
  jurisdiction String?
  country      String?     @default("United States")
  state        String?
  county       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  documents    Document[]
  filings      Filing[]
  drafts       Draft[]
  draftCases   DraftCase[]

  @@index([path])
  @@index([caseNumber])
}

model Filing {
  id          String     @id @default(uuid())
  caseId      String
  case        Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filingType  String
  title       String
  slug        String
  filingDate  DateTime?
  description  String?
  volumeNumber      Int?
  isSupplemental    Boolean   @default(false)
  supplementalOrder Int?      // 1 = 1st supplemental, 2 = 2nd, etc.
  createdAt    DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]
  motions     Motion[]

  @@unique([caseId, slug])
  @@index([caseId])
  @@index([filingType])
}

model Document {
  id                String    @id @default(uuid())
  caseId            String
  case              Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filingId          String?
  filing            Filing?   @relation(fields: [filingId], references: [id], onDelete: SetNull)
  filePath          String    @unique
  fileName          String
  hash              String    @unique
  status            String    @default("QUEUED")
  documentType      String?
  documentSummary   String?
  exhibitLabel      String?
  errorMessage      String?
  pageCount         Int?
  detectedExhibits  Int       @default(0)
  embeddingModel    String?
  ingestCheckpoint  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([caseId])
  @@index([filingId])
  @@index([status])
  @@index([hash])
  @@index([documentType])
  @@index([embeddingModel])
}

model JobLog {
  id                  String    @id @default(uuid())
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  documentsQueued     Int
  documentsProcessed  Int
  documentsFailed     Int
  errorSummary        String?

  @@index([startedAt])
}

model Config {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ModelDownload {
  id                String    @id @default(uuid())
  modelName         String    @unique
  provider          String
  status            String
  downloadProgress  Float     @default(0)
  sizeBytes         BigInt?
  downloadedAt      DateTime?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([provider])
  @@index([status])
}

model PageCache {
  id          String   @id @default(uuid())
  documentId  String
  pageNumber  Int
  text        String
  textDensity Int
  source      String   // 'extract' or 'ocr'
  confidence  Float?
  createdAt   DateTime @default(now())

  @@unique([documentId, pageNumber])
  @@index([documentId])
  @@index([source])
}

model ActionLog {
  id          String   @id @default(uuid())
  caseId      String?
  action      String
  target      String
  status      String   @default("pending")
  detail      String?
  logType     String   @default("general")
  createdAt   DateTime @default(now())

  @@index([caseId])
  @@index([logType])
  @@index([createdAt])
  @@index([status])
}

model Motion {
  id          String    @id @default(uuid())
  filingId    String
  filing      Filing    @relation(fields: [filingId], references: [id], onDelete: Cascade)
  title       String
  startPage   Int
  endPage     Int?
  description String?
  exhibits    Exhibit[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([filingId])
}

model Exhibit {
  id          String    @id @default(uuid())
  motionId    String
  motion      Motion    @relation(fields: [motionId], references: [id], onDelete: Cascade)
  label       String
  title       String?
  startPage   Int
  endPage     Int?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([motionId])
}

model WorkflowTemplate {
  id           String     @id @default(uuid())
  name         String     @unique
  jurisdiction String?
  category     String?
  tags         String     @default("[]")
  description  String?
  content      String
  workflows    Workflow[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([category])
}

model Workflow {
  id          String             @id @default(uuid())
  caseId      String
  templateId  String?
  template    WorkflowTemplate?  @relation(fields: [templateId], references: [id])
  title       String
  slug        String
  content     String             @default("")
  status      String             @default("draft")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([caseId, slug])
  @@index([caseId])
}

model Draft {
  id            String          @id @default(uuid())
  caseId        String
  case          Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title         String
  slug          String
  documentType  String
  content       String          @default("")
  status        String          @default("draft")
  version       Int             @default(1)
  // Vector indexing tracking
  indexingStatus  String?
  lastIndexedAt   DateTime?
  indexedVersion  Int?
  embeddingModel  String?
  indexingError   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  versions      DraftVersion[]
  draftCases    DraftCase[]
  suggestions   DraftSuggestion[]

  @@unique([caseId, slug])
  @@index([caseId])
  @@index([documentType])
}

model DraftCase {
  id        String   @id @default(uuid())
  draftId   String
  draft     Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([draftId, caseId])
  @@index([draftId])
  @@index([caseId])
}

model DraftVersion {
  id            String    @id @default(uuid())
  draftId       String
  draft         Draft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  version       Int
  content       String
  changeSummary String?
  createdAt     DateTime  @default(now())

  @@index([draftId])
}

// Auto-suggest mode: structured edit proposals generated by the AI in the draft chat
// panel. Each row is one suggestion card; status transitions accepted/denied/ignored
// drive the learning loop via UserPreferenceSignal.
model DraftSuggestion {
  id                String    @id @default(uuid())
  draftId           String
  draft             Draft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  sessionId         String                            // groups suggestions from one chat turn
  draftVersion      Int                               // Draft.version at creation time
  anchorFrom        Int                               // PM pos at creation (seed for live mapping)
  anchorTo          Int
  originalText      String                            // exact substring the AI targeted
  proposedText      String                            // replacement
  category          String                            // tone|grammar|structure|citation|clarity|other
  reason            String                            // AI rationale (<= 240 chars)
  confidence        Float?                            // optional 0-1 from model
  status            String    @default("pending")     // pending|accepted|denied|ignored|stale
  denyReasonTags    String    @default("[]")          // JSON array of tag slugs
  denyReasonText    String?                           // optional free text
  regenerationCount Int       @default(0)             // times the Regenerate button was used on this row (max 3)
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([draftId, status])
  @@index([sessionId])
}

// Learning loop: one row per learned user preference, derived from accepted/denied
// DraftSuggestion rows. Summarised and injected into the system prompt on subsequent
// Auto-Suggest calls so the AI adapts to the user's style.
model UserPreferenceSignal {
  id           String   @id @default(uuid())
  caseId       String?                              // nullable scoping tiers
  draftId      String?
  documentType String?                              // e.g. "motion", "brief"
  signal       String                               // prefer|avoid
  category     String                               // mirrors DraftSuggestion.category
  summary      String                               // <= 120 char rule
  examplePairs String   @default("[]")              // JSON: up to 3 {original, proposed} few-shot pairs
  weight       Float    @default(1.0)               // decays over time
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([draftId, signal, category])
  @@index([caseId])
}

model SidecarCommand {
  id          String   @id @default(uuid())
  sidecarUrl  String
  action      String
  payload     String   @default("{}")
  status      String   @default("pending")
  result      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime

  @@index([sidecarUrl, status])
  @@index([status, expiresAt])
}
