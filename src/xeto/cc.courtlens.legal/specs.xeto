//
// cc.courtlens.legal::specs — domain entities.
//
// Containment idiom follows Project Haystack:
//   Case  = site   (geographic container)
//   Motion = equip  (nestable for amendment chains via motionRef)
//   MotionEvent = point (Received / Filed / Responded / Signed ...)
//   MotionAttachment = point-adjacent (Brief, Response, ProposedOrder, ...)
//
// Amendment is an `Amendable` mixin (from proc.core) reused on Motion
// and on every MotionAttachment subtype.
//

//////////////////////////////////////////////////////////////////////////
// Jurisdiction + Court
//////////////////////////////////////////////////////////////////////////

// Legal jurisdiction (Texas, California, Federal, ...).
Jurisdiction: Dict {
  jurisdiction
  code:        Str
  displayName: Str
  parent:      Ref?
}

// Court of record.
Court: Dict {
  court
  displayName:     Str
  jurisdictionRef: Ref
  county:          Str?
  district:        Str?
}

//////////////////////////////////////////////////////////////////////////
// Person — canonical, immutable identity pool
//////////////////////////////////////////////////////////////////////////

// Canonical immutable identity. Intrinsic markers describe WHO the
// person is in the abstract (judge, lawyer, ...); contextual roles
// (movant, respondent, ...) live on PersonRole ghost records.
Person: Dict {
  person
  displayName:      Str
  email:            Str?
  barNumber:        Str?
  jurisdictionRef:  Ref?
  // Intrinsic role markers (always-true facts about this person):
  lawyer:           Marker?
  judge:            Marker?
  courtClerk:       Marker?
  courtReporter:    Marker?
  bailiff:          Marker?
  proSe:            Marker?
  self:             Marker?
}

// Ghost / virtual record that binds a canonical Person to a scope
// (a Motion or a Case) with contextual role tags. Solves the
// immutability problem: Person records never mutate; role records
// are created per binding and may carry contradictory roles across
// scopes (Alper is movant in M1, respondent in M2).
PersonRole: Dict {
  personRole
  personRef:  Ref
  scopeRef:   Ref
  // Contextual role markers — any combination may apply:
  movant:           Marker?
  respondent:       Marker?
  defendant:        Marker?
  plaintiff:        Marker?
  intervenor:       Marker?
  lawyerMovant:     Marker?
  lawyerRespondent: Marker?
  judge:            Marker?
  appearedOn:       DateTime?
  withdrewOn:       DateTime?
}

//////////////////////////////////////////////////////////////////////////
// Case — Haystack site analog
//////////////////////////////////////////////////////////////////////////

// Legal case. Container of motions, hearings, and party records.
// Case — all slots optional. Real entity identity lives in Prisma columns
// (name, caseNumber, jurisdiction); the tags JSON is for free-form markers
// the user adds incrementally via the tag-panel. Requiring fields here
// would break partial edits and force users to set 4 things at once just
// to add a single marker. Jurisdiction-specific markers are first-class so
// the panel's combo picker can offer them as taggable options.
Case: Dict {
  case
  site:               Marker?
  causeNo:            Str?
  jurisdictionRef:    Ref?
  jurisdictionTx:     Marker?
  jurisdictionCa:     Marker?
  jurisdictionFed:    Marker?
  courtRef:           Ref?
  judgeRefs:          List? <of:Ref>
  plaintiffRefs:      List? <of:Ref>
  defendantRefs:      List? <of:Ref>
  respondentRefs:     List? <of:Ref>
  movantRefs:         List? <of:Ref>
  courtClerkRefs:     List? <of:Ref>
  courtReporterRefs:  List? <of:Ref>
  filedOn:            DateTime?
  causeFiledStamp:    Str?
}

//////////////////////////////////////////////////////////////////////////
// Motion — Haystack equip analog, nestable, Amendable
//////////////////////////////////////////////////////////////////////////

// Motion. Equip-like; nestable via motionRef to model amendment chains
// ("Motion to Disqualify" → "Amended Motion to Disqualify" → ...).
// Intersects Amendable from proc.core.
// Motion — slots optional for incremental tag editing. Identity (caseId,
// motionType) lives in Prisma columns; tags JSON carries the open-ended
// marker/ref set the user maintains via the panel.
Motion: Amendable {
  motion
  equip:          Marker?
  caseRef:        Ref?
  motionRef:      Ref?
  subMotion:      Marker?
  motionType:     Str?
  judgeRef:       Ref?
  movantRef:      Ref?
  respondentRef:  Ref?
  appellate:      Marker?
}

//////////////////////////////////////////////////////////////////////////
// EventKind — exclusive Choice over MotionEvent lifecycle states
//////////////////////////////////////////////////////////////////////////

// MotionEvent kind. Exclusive Choice — exactly one applies per event.
EventKind: Choice

Received:    EventKind { received }
Filed:       EventKind { filed }
CourtFiled:  EventKind { courtFiled }
Responded:   EventKind { responded }
Signed:      EventKind { signed }
Granted:     EventKind { granted }
Denied:      EventKind { denied }
Served:      EventKind { served }
HearingHeld: EventKind { hearingHeld }
Withdrawn:   EventKind { withdrawn }
Mooted:      EventKind { mooted }

//////////////////////////////////////////////////////////////////////////
// MotionType — Choice catalogue for Motion.motionType
//////////////////////////////////////////////////////////////////////////

// MotionType. Open-ended Choice; new subtypes can be appended as
// legal practice evolves. Unlike EventKind, this Choice is purely a
// *catalogue*: Motion.motionType remains `Str?` and stores the
// camelCase slug (e.g. "disqualify"). The combo picker in the tag
// panel pulls the canonical list + display names from
// src/lib/filings/motion-types.ts; XETO-only consumers can iterate
// the subtypes here.
MotionType: Choice

Disqualify:         MotionType { disqualify }
SummaryJudgment:    MotionType { summaryJudgment }
Dismiss:            MotionType { dismiss }
Strike:             MotionType { strike }
Compel:             MotionType { compel }
InLimine:           MotionType { inLimine }
Continue:           MotionType { continueMotion }
Reconsider:         MotionType { reconsider }
Modify:             MotionType { modify }
Withdraw:           MotionType { withdraw }
AppointReceiver:    MotionType { appointReceiver }
NewTrial:           MotionType { newTrial }
Rehearing:          MotionType { rehearing }
Recuse:             MotionType { recuse }
Sanctions:          MotionType { sanctions }
ProtectiveOrder:    MotionType { protectiveOrder }
QuashSubpoena:      MotionType { quashSubpoena }
Abate:              MotionType { abate }
Remand:             MotionType { remand }
EmergencyStay:      MotionType { emergencyStay }
Consolidate:        MotionType { consolidate }
TemporaryOrders:    MotionType { temporaryOrders }
Enforcement:        MotionType { enforcement }
BillOfReviewMotion: MotionType { billOfReview }
SetAside:           MotionType { setAside }
LeaveToFile:        MotionType { leaveToFile }
ExtensionOfTime:    MotionType { extensionOfTime }
SubstitutedService: MotionType { substitutedService }
OtherMotion:        MotionType { otherMotion }

//////////////////////////////////////////////////////////////////////////
// MotionEvent — Haystack point analog
//////////////////////////////////////////////////////////////////////////

// MotionEvent. Lifecycle as discrete records, not as additive markers
// on Motion. Each event carries a kind + occurredOn + optional fileRef
// pointing at the PDF that documents it.
// MotionEvent — `kind` Choice is the only load-bearing constraint
// (received xor filed xor signed ...); refs are optional for partial edits.
MotionEvent: Dict {
  motionEvent
  point:              Marker?
  motionRef:          Ref?
  caseRef:            Ref?
  kind:               EventKind
  occurredOn:         DateTime?
  courtFilingDate:    DateTime?
  causeNoStamp:       Str?
  fileRef:            Ref?
  authoredBy:         Ref?
  servedOn:           Ref?
  courtClerkRef:      Ref?
  courtReporterRef:   Ref?
  judgeRef:           Ref?
  hearingRef:         Ref?
}

//////////////////////////////////////////////////////////////////////////
// Hearing — shared cross-motion entity (hybrid hearings)
//////////////////////////////////////////////////////////////////////////

// First-class shared hearing record. Hybrid hearings cover multiple
// motions across multiple cases; this record holds the shared facts
// (judge, reporter, transcript, time, room) while each affected motion
// gets its own MotionEvent{hearingHeld} pointing at this Hearing.
Hearing: Dict {
  hearing
  hybrid:            Marker?
  caseRefs:          List <of:Ref>
  motionRefs:        List <of:Ref>
  judgeRef:          Ref
  courtReporterRef:  Ref?
  courtClerkRef:     Ref?
  scheduledFor:      DateTime
  heldOn:            DateTime?
  durationMin:       Number?
  location:          Str?
  remote:            Marker?
  transcriptRef:     Ref?
  hearingType:       Str?
}

//////////////////////////////////////////////////////////////////////////
// MotionAttachment — non-event documents attached to a motion
//////////////////////////////////////////////////////////////////////////

// Abstract: anything attached to a motion or case as a discrete
// document/event-of-record. Subtypes carry their own kind marker
// (notice, letter, brief, ...). All slots optional — real entity
// identity lives in Prisma columns; tags JSON carries the open-ended
// marker set users edit incrementally via the panel.
//
// MotionAttachment intersects Amendable so any subtype can chain
// (amended brief, second amended proposed order, ...). For naturally
// final docs (Order signed, Judgment, Decree, Transcript) the inherited
// `amends` / `supersedes` slots are simply left empty.
MotionAttachment: Amendable <abstract> {
  attachment
  motionRef:       Ref?
  caseRef:         Ref?
  fileRef:         Ref?
  authoredBy:      Ref?
  filedOn:         DateTime?
  receivedOn:      DateTime?
  attachmentKind:  Str?
}

//////////////////////////////////////////////////////////////////////////
// Filing-type subtypes — one per Filing.filingType label
// (see src/services/filing-type-classifier.ts for the canonical 24).
// Each carries its kind marker as the only required slot; everything
// else is optional so the tag panel can edit partial dicts.
//////////////////////////////////////////////////////////////////////////

Notice: MotionAttachment {
  notice
  noticeType:  Str?
}

Letter: MotionAttachment {
  letter
  from:     Ref?
  to:       List? <of:Ref>
  sentOn:   DateTime?
  subject:  Str?
}

Order: MotionAttachment {
  order
  orderType:  Str?
  signedBy:   Ref?
  signedOn:   DateTime?
}

ProposedOrder: Order {
  proposedOrder
}

Petition: MotionAttachment {
  petition
  petitionType:  Str?
}

Affidavit: MotionAttachment {
  affidavit
  affiant:      Ref?
  swornOn:      DateTime?
  notarizedBy:  Ref?
}

Subpoena: MotionAttachment {
  subpoena
  subpoenaType:  Str?
  servedOn:      Ref?
  servedAt:      DateTime?
  returnDate:    DateTime?
}

Brief: MotionAttachment {
  brief
  briefType:  Str?
  wordCount:  Number?
}

Response: MotionAttachment {
  response
  respondingTo:  Ref?
}

Reply: MotionAttachment {
  reply
  replyingTo:  Ref?
}

Judgment: MotionAttachment {
  judgment
  judgmentType:  Str?
  signedBy:      Ref?
  signedOn:      DateTime?
}

Decree: MotionAttachment {
  decree
  decreeType:  Str?
  signedBy:    Ref?
  signedOn:    DateTime?
}

ClerksRecord: MotionAttachment {
  clerksRecord
  volume:      Number?
  preparedBy:  Ref?
  preparedOn:  DateTime?
}

ReportersRecord: MotionAttachment {
  reportersRecord
  volume:       Number?
  reporter:     Ref?
  hearingDate:  DateTime?
}

Transcript: MotionAttachment {
  transcript
  reporter:     Ref?
  hearingDate:  DateTime?
  pageCount:    Number?
}

Settlement: MotionAttachment {
  settlement
  settledOn:  DateTime?
  parties:    List? <of:Ref>
}

BillOfReview: MotionAttachment {
  billOfReview
}

ReturnOfService: MotionAttachment {
  returnOfService
  servedOn:      Ref?
  servedAt:      DateTime?
  servedBy:      Ref?
  servedMethod:  Str?
}

DemandLetter: MotionAttachment {
  demandLetter
  from:          Ref?
  to:            List? <of:Ref>
  sentOn:        DateTime?
  demandAmount:  Number?
}

Objection: MotionAttachment {
  objection
  objectionTo:  Ref?
  basis:        Str?
}

Request: MotionAttachment {
  request
  requestType:  Str?
}

Supplement: MotionAttachment {
  supplement
  supplements:  Ref?
}

Designation: MotionAttachment {
  designation
  designationOf:  Str?
  designatedRef:  Ref?
}

Other: MotionAttachment {
  other
}

//////////////////////////////////////////////////////////////////////////
// Legacy attachment subtypes (kept for back-compat with v1 ingestion).
//////////////////////////////////////////////////////////////////////////

Exhibit: MotionAttachment {
  exhibit
  label:  Str?
}

Email: MotionAttachment {
  email
  fromRef:  Ref?
  toRefs:   List? <of:Ref>
  subject:  Str?
  sentOn:   DateTime?
}

Evidence:      MotionAttachment { evidence }
SupportingDoc: MotionAttachment { supportingDoc }
